# Copy to .env and fill in. .env is gitignored.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# https://the-odds-api.com/ -- free "Starter" tier is 500 credits/month
ODDS_API_KEY=

# Optional: path to a Firebase service account key. Absent means `edgelord sync`
# only writes the local JSON snapshot the dashboard falls back to.
FIREBASE_CREDENTIALS=

# Optional overrides
EDGELORD_MODEL=claude-opus-4-8
EDGELORD_ODDS_MONTHLY_BUDGET=500
