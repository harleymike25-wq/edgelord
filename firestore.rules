rules_version = '2';

// The dashboard reads Firestore server-side through the Admin SDK, which
// bypasses these rules entirely. No browser ever connects to Firestore
// directly, so the correct client-facing policy is to deny everything --
// there is no public read surface to secure.
//
// If you later add a client-side SDK (e.g. for live updates), relax the read
// rule on `games` and `meta` only, and keep writes denied: the Python job is
// the sole writer and it authenticates with a service account.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
